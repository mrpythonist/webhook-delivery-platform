# Copy to .env for local development outside Docker.
# Inside docker compose, DATABASE_URL/REDIS_URL are overridden by the service
# environment (see docker-compose.yml).

# Prisma / Postgres
DATABASE_URL=postgres://webhooks:webhooks@localhost:5432/webhooks

# BullMQ / Redis
REDIS_URL=redis://localhost:6379

# API port
PORT=3001
